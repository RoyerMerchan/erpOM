{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

http://:{$MAX_SPORT_HTTP_PORT:80} {
	bind {$MAX_SPORT_PROXY_BIND:0.0.0.0}
	redir {$APP_ORIGIN}{uri} 308
}

{$APP_ORIGIN} {
	bind {$MAX_SPORT_PROXY_BIND:0.0.0.0}
	root * "{$MAX_SPORT_WEB_ROOT:apps/web/dist}"
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy {$MAX_SPORT_API_UPSTREAM:127.0.0.1:3000}
	}

	handle /assets/* {
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 2xx 304
		}
		file_server
	}

	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
