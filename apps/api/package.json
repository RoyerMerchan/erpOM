{
  "name": "@max-sport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test/smoke.test.ts test/master-data.test.ts test/purchase-money.test.ts test/sale-pricing.test.ts test/return-money.test.ts test/finance-calendar.test.ts",
    "test:integration": "vitest run --no-file-parallelism test/integration.test.ts test/phase1.integration.test.ts test/phase2.integration.test.ts test/phase3.integration.test.ts test/phase4.integration.test.ts test/phase5.integration.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:bootstrap": "tsx src/cli/init-admin.ts",
    "db:seed:demo": "tsx src/cli/init-admin.ts --demo"
  },
  "dependencies": {
    "@max-sport/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@max-sport/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vitest": "^5.1.1"
  }
}
