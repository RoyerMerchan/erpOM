generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  CASH
  BANK
  MOBILE
  CRYPTO
  OTHER
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  label       String           @db.VarChar(100)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique @db.VarChar(80)
  label String           @db.VarChar(140)
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  email              String            @unique @db.VarChar(254)
  displayName        String            @map("display_name") @db.VarChar(120)
  passwordHash       String            @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean           @default(false) @map("must_change_password")
  active             Boolean           @default(true)
  roleId             String            @map("role_id") @db.Uuid
  role               Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions           UserSession[]
  auditLogs          AuditLog[]
  exchangeRates      ExchangeRate[]
  purchasesCreated   Purchase[]        @relation("PurchaseCreator")
  purchasesReceived  Purchase[]        @relation("PurchaseReceiver")
  purchasesVoided    Purchase[]        @relation("PurchaseVoider")
  supplierPayments   SupplierPayment[] @relation("SupplierPaymentCreator")
  supplierReversals  SupplierPayment[] @relation("SupplierPaymentReverser")
  stockMovements     StockMovement[]
  moneyMovements     MoneyMovement[]
  sales              Sale[]            @relation("SaleSeller")
  salesConfirmed     Sale[]            @relation("SaleOperator")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  layaways           Layaway[]
  layawayActions     LayawayAction[]
  saleCorrections    SaleCorrection[]

  @@index([roleId])
  @@map("users")
}

model UserSession {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(60)
  entityId  String   @map("entity_id") @db.VarChar(80)
  before    Json?    @map("before_data")
  after     Json?    @map("after_data")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Brand {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(120)
  nameKey   String         @unique @map("name_key") @db.VarChar(120)
  active    Boolean        @default(true)
  models    ProductModel[]
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brands")
}

model ProductModel {
  id          String           @id @default(uuid()) @db.Uuid
  brandId     String           @map("brand_id") @db.Uuid
  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name        String           @db.VarChar(140)
  nameKey     String           @map("name_key") @db.VarChar(140)
  description String?
  active      Boolean          @default(true)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([brandId, nameKey])
  @@map("product_models")
}

model ProductVariant {
  id                String            @id @default(uuid()) @db.Uuid
  modelId           String            @map("model_id") @db.Uuid
  model             ProductModel      @relation(fields: [modelId], references: [id], onDelete: Restrict)
  size              Int               @db.SmallInt
  color             String?           @db.VarChar(80)
  colorKey          String            @default("") @map("color_key") @db.VarChar(80)
  sku               String            @unique @db.VarChar(60)
  salePriceUsd      Decimal           @map("sale_price_usd") @db.Decimal(18, 2)
  lowStockThreshold Int?              @map("low_stock_threshold")
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  inventory         InventoryBalance?
  purchaseItems     PurchaseItem[]
  inventoryLots     InventoryLot[]
  stockMovements    StockMovement[]
  saleItems         SaleItem[]
  layawayItems      LayawayItem[]

  @@unique([modelId, size, colorKey])
  @@index([size])
  @@map("product_variants")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(160)
  document  String?   @db.VarChar(60)
  phone     String?   @db.VarChar(60)
  email     String?   @db.VarChar(254)
  address   String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sales     Sale[]
  layaways  Layaway[]

  @@index([name])
  @@index([document])
  @@map("customers")
}

model Supplier {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @db.VarChar(160)
  document  String?    @db.VarChar(60)
  phone     String?    @db.VarChar(60)
  email     String?    @db.VarChar(254)
  address   String?
  notes     String?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  purchases Purchase[]

  @@index([name])
  @@index([document])
  @@map("suppliers")
}

model Currency {
  code              String             @id @db.VarChar(5)
  name              String             @db.VarChar(80)
  minorUnits        Int                @map("minor_units") @db.SmallInt
  active            Boolean            @default(true)
  rates             ExchangeRate[]
  accounts          MoneyAccount[]
  purchases         Purchase[]
  payments          SupplierPayment[]
  saleTenders       SaleTender[]
  saleDiscounts     SaleDiscount[]
  layawayPayments   LayawayPayment[]
  correctionTenders CorrectionTender[]

  @@map("currencies")
}

model ExchangeRate {
  id                String             @id @default(uuid()) @db.Uuid
  currencyCode      String             @map("currency_code") @db.VarChar(5)
  currency          Currency           @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  unitsPerUsd       Decimal            @map("units_per_usd") @db.Decimal(30, 12)
  effectiveAt       DateTime           @map("effective_at") @db.Timestamptz(3)
  createdById       String             @map("created_by_id") @db.Uuid
  createdBy         User               @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(3)
  replacesId        String?            @unique @map("replaces_id") @db.Uuid
  replaces          ExchangeRate?      @relation("RateRevisions", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement       ExchangeRate?      @relation("RateRevisions")
  purchases         Purchase[]
  payments          SupplierPayment[]
  saleTenders       SaleTender[]
  saleDiscounts     SaleDiscount[]
  layawayPayments   LayawayPayment[]
  correctionTenders CorrectionTender[]

  @@index([currencyCode, effectiveAt(sort: Desc), createdAt(sort: Desc)])
  @@index([createdById])
  @@map("exchange_rates")
}

model MoneyAccount {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(120)
  currencyCode      String             @map("currency_code") @db.VarChar(5)
  currency          Currency           @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  kind              AccountKind
  active            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  payments          SupplierPayment[]
  movements         MoneyMovement[]
  saleTenders       SaleTender[]
  layawayPayments   LayawayPayment[]
  correctionTenders CorrectionTender[]

  @@unique([currencyCode, name])
  @@map("money_accounts")
}

model ShopSettings {
  id                  Int                 @id @default(1) @db.SmallInt
  name                String              @default("MAX Sport Manager") @db.VarChar(160)
  timezone            String              @default("America/Caracas") @db.VarChar(80)
  logoUrl             String?             @map("logo_url")
  lowStockThreshold   Int                 @default(0) @map("low_stock_threshold")
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  layawayRefundPolicy LayawayRefundPolicy @default(FULL_REFUND) @map("layaway_refund_policy")

  @@map("shop_settings")
}

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  VOIDED
}

enum StockMovementKind {
  RECEIPT
  RECEIPT_REVERSAL
  ADJUST_IN
  ADJUST_OUT
  SALE_OUT
  RESERVE
  RELEASE_RESERVATION
  SALE_RETURN_IN
}

enum MoneyMovementKind {
  SUPPLIER_PAYMENT
  SUPPLIER_PAYMENT_REVERSAL
  SALE_PAYMENT
  SALE_CHANGE
  LAYAWAY_DEPOSIT
  LAYAWAY_REFUND
  EXCHANGE_PAYMENT
  SALE_REFUND

  @@map("SupplierMoneyKind")
}

model Purchase {
  id                 String            @id @default(uuid()) @db.Uuid
  status             PurchaseStatus    @default(DRAFT)
  supplierId         String            @map("supplier_id") @db.Uuid
  supplier           Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  documentAt         DateTime          @map("document_at") @db.Timestamptz(3)
  reference          String?           @db.VarChar(120)
  notes              String?
  currencyCode       String            @map("currency_code") @db.VarChar(5)
  currency           Currency          @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  minorUnits         Int               @map("minor_units") @db.SmallInt
  exchangeRateId     String?           @map("exchange_rate_id") @db.Uuid
  exchangeRate       ExchangeRate?     @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  unitsPerUsd        Decimal?          @map("units_per_usd") @db.Decimal(30, 12)
  draftData          Json              @map("draft_data")
  revision           Int               @default(1)
  subtotalOriginal   Decimal           @map("subtotal_original") @db.Decimal(38, 8)
  freightOriginal    Decimal           @map("freight_original") @db.Decimal(38, 8)
  totalOriginal      Decimal           @map("total_original") @db.Decimal(38, 8)
  totalUsd           Decimal?          @map("total_usd") @db.Decimal(48, 2)
  paidUsd            Decimal           @default(0) @map("paid_usd") @db.Decimal(48, 2)
  pairCount          Int               @map("pair_count")
  createdById        String            @map("created_by_id") @db.Uuid
  createdBy          User              @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  receivedById       String?           @map("received_by_id") @db.Uuid
  receivedBy         User?             @relation("PurchaseReceiver", fields: [receivedById], references: [id], onDelete: Restrict)
  voidedById         String?           @map("voided_by_id") @db.Uuid
  voidedBy           User?             @relation("PurchaseVoider", fields: [voidedById], references: [id], onDelete: Restrict)
  receivedAt         DateTime?         @map("received_at") @db.Timestamptz(3)
  voidedAt           DateTime?         @map("voided_at") @db.Timestamptz(3)
  voidReason         String?           @map("void_reason")
  confirmationKey    String?           @map("confirmation_key") @db.Uuid
  confirmationDigest String?           @map("confirmation_digest") @db.Char(64)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  items              PurchaseItem[]
  payments           SupplierPayment[]

  @@index([status, documentAt])
  @@index([supplierId, documentAt])
  @@map("purchases")
}

model PurchaseItem {
  id               String          @id @default(uuid()) @db.Uuid
  purchaseId       String          @map("purchase_id") @db.Uuid
  purchase         Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  variantId        String          @map("variant_id") @db.Uuid
  variant          ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  position         Int
  brandName        String          @map("brand_name") @db.VarChar(120)
  modelName        String          @map("model_name") @db.VarChar(140)
  size             Int             @db.SmallInt
  sku              String          @db.VarChar(60)
  color            String?         @db.VarChar(80)
  quantity         Int
  salePriceUsd     Decimal         @map("sale_price_usd") @db.Decimal(18, 2)
  unitCostOriginal Decimal         @map("unit_cost_original") @db.Decimal(38, 8)
  freightOriginal  Decimal         @map("freight_original") @db.Decimal(38, 8)
  totalOriginal    Decimal         @map("total_original") @db.Decimal(38, 8)
  totalUsd         Decimal         @map("total_usd") @db.Decimal(48, 2)
  unitCostUsd      Decimal         @map("unit_cost_usd") @db.Decimal(56, 12)
  lot              InventoryLot?
  movements        StockMovement[]

  @@unique([purchaseId, variantId])
  @@unique([purchaseId, position])
  @@index([variantId])
  @@map("purchase_items")
}

model InventoryBalance {
  variantId String         @id @map("variant_id") @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  physical  Int            @default(0)
  reserved  Int            @default(0)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("inventory_balances")
}

model InventoryLot {
  id                String               @id @default(uuid()) @db.Uuid
  variantId         String               @map("variant_id") @db.Uuid
  variant           ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchaseItemId    String?              @unique @map("purchase_item_id") @db.Uuid
  purchaseItem      PurchaseItem?        @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  receivedAt        DateTime             @map("received_at") @db.Timestamptz(3)
  initialQuantity   Int                  @map("initial_quantity")
  remainingQuantity Int                  @map("remaining_quantity")
  unitCostUsd       Decimal              @map("unit_cost_usd") @db.Decimal(56, 12)
  totalCostUsd      Decimal              @map("total_cost_usd") @db.Decimal(48, 2)
  remainingCostUsd  Decimal              @map("remaining_cost_usd") @db.Decimal(48, 2)
  allocations       StockLotAllocation[]
  correctionItemId  String?              @map("correction_item_id") @db.Uuid
  correctionItem    SaleCorrectionItem?  @relation(fields: [correctionItemId], references: [id], onDelete: Restrict)
  originLotId       String?              @map("origin_lot_id") @db.Uuid
  originLot         InventoryLot?        @relation("RestockedLot", fields: [originLotId], references: [id], onDelete: Restrict)
  restocks          InventoryLot[]       @relation("RestockedLot")

  @@index([variantId, receivedAt, id])
  @@map("inventory_lots")
}

model StockMovement {
  id               String               @id @default(uuid()) @db.Uuid
  variantId        String               @map("variant_id") @db.Uuid
  variant          ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  purchaseItemId   String?              @map("purchase_item_id") @db.Uuid
  purchaseItem     PurchaseItem?        @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)
  saleItemId       String?              @unique @map("sale_item_id") @db.Uuid
  saleItem         SaleItem?            @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  kind             StockMovementKind
  quantityDelta    Int                  @map("quantity_delta")
  reason           String?
  operationKey     String?              @unique @map("operation_key") @db.Uuid
  operationDigest  String?              @map("operation_digest") @db.Char(64)
  actorId          String               @map("actor_id") @db.Uuid
  actor            User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  occurredAt       DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  allocations      StockLotAllocation[]
  reservedDelta    Int                  @default(0) @map("reserved_delta")
  layawayItemId    String?              @map("layaway_item_id") @db.Uuid
  layawayItem      LayawayItem?         @relation(fields: [layawayItemId], references: [id], onDelete: Restrict)
  correctionItemId String?              @unique @map("correction_item_id") @db.Uuid
  correctionItem   SaleCorrectionItem?  @relation(fields: [correctionItemId], references: [id], onDelete: Restrict)

  @@unique([purchaseItemId, kind])
  @@unique([layawayItemId, kind])
  @@index([variantId, occurredAt])
  @@map("stock_movements")
}

model StockLotAllocation {
  movementId String        @map("movement_id") @db.Uuid
  movement   StockMovement @relation(fields: [movementId], references: [id], onDelete: Restrict)
  lotId      String        @map("lot_id") @db.Uuid
  lot        InventoryLot  @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantity   Int
  costUsd    Decimal       @map("cost_usd") @db.Decimal(48, 2)

  @@id([movementId, lotId])
  @@index([lotId])
  @@map("stock_lot_allocations")
}

model SupplierPayment {
  id              String          @id @default(uuid()) @db.Uuid
  purchaseId      String          @map("purchase_id") @db.Uuid
  purchase        Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  accountId       String          @map("account_id") @db.Uuid
  account         MoneyAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  currencyCode    String          @map("currency_code") @db.VarChar(5)
  currency        Currency        @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  exchangeRateId  String?         @map("exchange_rate_id") @db.Uuid
  exchangeRate    ExchangeRate?   @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  unitsPerUsd     Decimal         @map("units_per_usd") @db.Decimal(30, 12)
  amountOriginal  Decimal         @map("amount_original") @db.Decimal(38, 8)
  amountUsd       Decimal         @map("amount_usd") @db.Decimal(48, 2)
  paidAt          DateTime        @map("paid_at") @db.Timestamptz(3)
  reference       String?         @db.VarChar(120)
  operationKey    String          @map("operation_key") @db.Uuid
  operationDigest String          @map("operation_digest") @db.Char(64)
  createdById     String          @map("created_by_id") @db.Uuid
  createdBy       User            @relation("SupplierPaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversedAt      DateTime?       @map("reversed_at") @db.Timestamptz(3)
  reversedById    String?         @map("reversed_by_id") @db.Uuid
  reversedBy      User?           @relation("SupplierPaymentReverser", fields: [reversedById], references: [id], onDelete: Restrict)
  reversalReason  String?         @map("reversal_reason")
  movements       MoneyMovement[]

  @@unique([purchaseId, operationKey])
  @@index([accountId, paidAt])
  @@map("supplier_payments")
}

model MoneyMovement {
  id                 String            @id @default(uuid()) @db.Uuid
  kind               MoneyMovementKind
  paymentId          String?           @map("payment_id") @db.Uuid
  payment            SupplierPayment?  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  saleTenderId       String?           @unique @map("sale_tender_id") @db.Uuid
  saleTender         SaleTender?       @relation(fields: [saleTenderId], references: [id], onDelete: Restrict)
  accountId          String            @map("account_id") @db.Uuid
  account            MoneyAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  currencyCode       String            @map("currency_code") @db.VarChar(5)
  unitsPerUsd        Decimal           @map("units_per_usd") @db.Decimal(30, 12)
  amountOriginal     Decimal           @map("amount_original") @db.Decimal(38, 8)
  amountUsd          Decimal           @map("amount_usd") @db.Decimal(48, 2)
  actorId            String            @map("actor_id") @db.Uuid
  actor              User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  occurredAt         DateTime          @map("occurred_at") @db.Timestamptz(3)
  layawayPaymentId   String?           @unique @map("layaway_payment_id") @db.Uuid
  layawayPayment     LayawayPayment?   @relation(fields: [layawayPaymentId], references: [id], onDelete: Restrict)
  correctionTenderId String?           @unique @map("correction_tender_id") @db.Uuid
  correctionTender   CorrectionTender? @relation(fields: [correctionTenderId], references: [id], onDelete: Restrict)

  @@unique([paymentId, kind])
  @@index([accountId, occurredAt])
  @@map("money_movements")
}

enum SaleTenderKind {
  PAYMENT
  CHANGE
}

enum SaleDiscountKind {
  PERCENT
  FIXED
}

model Sale {
  id              String           @id @default(uuid()) @db.Uuid
  receiptNumber   BigInt           @unique @default(autoincrement()) @map("receipt_number")
  operationKey    String           @unique @map("operation_key") @db.Uuid
  operationDigest String           @map("operation_digest") @db.Char(64)
  customerId      String?          @map("customer_id") @db.Uuid
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName    String           @map("customer_name") @db.VarChar(160)
  shopName        String           @map("shop_name") @db.VarChar(160)
  sellerId        String           @map("seller_id") @db.Uuid
  seller          User             @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  sellerName      String           @map("seller_name") @db.VarChar(120)
  actorId         String           @map("actor_id") @db.Uuid
  actor           User             @relation("SaleOperator", fields: [actorId], references: [id], onDelete: Restrict)
  notes           String?
  subtotalUsd     Decimal          @map("subtotal_usd") @db.Decimal(48, 2)
  discountUsd     Decimal          @map("discount_usd") @db.Decimal(48, 2)
  totalUsd        Decimal          @map("total_usd") @db.Decimal(48, 2)
  cogsUsd         Decimal          @map("cogs_usd") @db.Decimal(48, 2)
  grossProfitUsd  Decimal          @map("gross_profit_usd") @db.Decimal(48, 2)
  confirmedAt     DateTime         @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  items           SaleItem[]
  tenders         SaleTender[]
  discounts       SaleDiscount[]
  layawayId       String?          @unique @map("layaway_id") @db.Uuid
  layaway         Layaway?         @relation(fields: [layawayId], references: [id], onDelete: Restrict)
  exchangeId      String?          @unique @map("exchange_id") @db.Uuid
  exchange        SaleCorrection?  @relation("ReplacementSale", fields: [exchangeId], references: [id], onDelete: Restrict)
  corrections     SaleCorrection[] @relation("CorrectedSale")

  @@index([confirmedAt, id])
  @@index([sellerId, confirmedAt])
  @@index([customerId, confirmedAt])
  @@map("sales")
}

model SaleItem {
  id                String               @id @default(uuid()) @db.Uuid
  saleId            String               @map("sale_id") @db.Uuid
  sale              Sale                 @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variantId         String               @map("variant_id") @db.Uuid
  variant           ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  position          Int
  brandName         String               @map("brand_name") @db.VarChar(120)
  modelName         String               @map("model_name") @db.VarChar(140)
  sku               String               @db.VarChar(60)
  size              Int                  @db.SmallInt
  color             String?              @db.VarChar(80)
  quantity          Int
  unitPriceUsd      Decimal              @map("unit_price_usd") @db.Decimal(18, 2)
  grossUsd          Decimal              @map("gross_usd") @db.Decimal(48, 2)
  lineDiscountUsd   Decimal              @map("line_discount_usd") @db.Decimal(48, 2)
  globalDiscountUsd Decimal              @map("global_discount_usd") @db.Decimal(48, 2)
  netUsd            Decimal              @map("net_usd") @db.Decimal(48, 2)
  cogsUsd           Decimal              @map("cogs_usd") @db.Decimal(48, 2)
  discount          SaleDiscount?
  movement          StockMovement?
  corrections       SaleCorrectionItem[]

  @@unique([saleId, position])
  @@unique([saleId, variantId])
  @@index([variantId])
  @@map("sale_items")
}

model SaleDiscount {
  id             String           @id @default(uuid()) @db.Uuid
  saleId         String           @map("sale_id") @db.Uuid
  sale           Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  saleItemId     String?          @unique @map("sale_item_id") @db.Uuid
  saleItem       SaleItem?        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  kind           SaleDiscountKind
  percentage     Decimal?         @db.Decimal(7, 4)
  currencyCode   String?          @map("currency_code") @db.VarChar(5)
  currency       Currency?        @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  amountOriginal Decimal?         @map("amount_original") @db.Decimal(38, 8)
  unitsPerUsd    Decimal?         @map("units_per_usd") @db.Decimal(30, 12)
  exchangeRateId String?          @map("exchange_rate_id") @db.Uuid
  exchangeRate   ExchangeRate?    @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  amountUsd      Decimal          @map("amount_usd") @db.Decimal(48, 2)

  @@index([saleId])
  @@map("sale_discounts")
}

model SaleTender {
  id             String         @id @default(uuid()) @db.Uuid
  saleId         String         @map("sale_id") @db.Uuid
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  kind           SaleTenderKind
  position       Int
  accountId      String         @map("account_id") @db.Uuid
  account        MoneyAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountName    String         @map("account_name") @db.VarChar(120)
  currencyCode   String         @map("currency_code") @db.VarChar(5)
  currency       Currency       @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  exchangeRateId String?        @map("exchange_rate_id") @db.Uuid
  exchangeRate   ExchangeRate?  @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  unitsPerUsd    Decimal        @map("units_per_usd") @db.Decimal(30, 12)
  amountOriginal Decimal        @map("amount_original") @db.Decimal(38, 8)
  amountUsd      Decimal        @map("amount_usd") @db.Decimal(48, 2)
  reference      String?        @db.VarChar(120)
  movement       MoneyMovement?

  @@unique([saleId, position])
  @@index([accountId])
  @@map("sale_tenders")
}

enum LayawayStatus {
  ACTIVE
  PAID
  DELIVERED
  CANCELLED
  EXPIRED
}

enum LayawayRefundPolicy {
  FULL_REFUND
  RETAIN
}

enum LayawayActionKind {
  CREATE
  PAY
  DELIVER
  CANCEL
  EXPIRE
}

enum LayawayPaymentKind {
  DEPOSIT
  REFUND
}

model Layaway {
  id           String              @id @default(uuid()) @db.Uuid
  number       BigInt              @unique @default(autoincrement())
  customerId   String              @map("customer_id") @db.Uuid
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName String              @map("customer_name") @db.VarChar(160)
  sellerId     String              @map("seller_id") @db.Uuid
  seller       User                @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerName   String              @map("seller_name") @db.VarChar(120)
  notes        String?
  status       LayawayStatus       @default(ACTIVE)
  refundPolicy LayawayRefundPolicy @map("refund_policy")
  createdAt    DateTime            @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime?           @map("expires_at") @db.Timestamptz(3)
  closedAt     DateTime?           @map("closed_at") @db.Timestamptz(3)
  totalUsd     Decimal             @map("total_usd") @db.Decimal(48, 2)
  paidUsd      Decimal             @map("paid_usd") @db.Decimal(48, 2)
  items        LayawayItem[]
  actions      LayawayAction[]
  sale         Sale?

  @@index([status, expiresAt])
  @@index([createdAt, id])
  @@index([sellerId, createdAt])
  @@index([customerId, createdAt])
  @@map("layaways")
}

model LayawayItem {
  id           String          @id @default(uuid()) @db.Uuid
  layawayId    String          @map("layaway_id") @db.Uuid
  layaway      Layaway         @relation(fields: [layawayId], references: [id], onDelete: Restrict)
  variantId    String          @map("variant_id") @db.Uuid
  variant      ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  position     Int
  brandName    String          @map("brand_name") @db.VarChar(120)
  modelName    String          @map("model_name") @db.VarChar(140)
  sku          String          @db.VarChar(60)
  size         Int             @db.SmallInt
  color        String?         @db.VarChar(80)
  quantity     Int
  unitPriceUsd Decimal         @map("unit_price_usd") @db.Decimal(18, 2)
  totalUsd     Decimal         @map("total_usd") @db.Decimal(48, 2)
  movements    StockMovement[]

  @@unique([layawayId, position])
  @@unique([layawayId, variantId])
  @@index([variantId])
  @@map("layaway_items")
}

model LayawayAction {
  id          String            @id @db.Uuid
  layawayId   String            @map("layaway_id") @db.Uuid
  layaway     Layaway           @relation(fields: [layawayId], references: [id], onDelete: Restrict)
  actorId     String            @map("actor_id") @db.Uuid
  actor       User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorName   String            @map("actor_name") @db.VarChar(120)
  kind        LayawayActionKind
  fingerprint String            @db.Char(64)
  reason      String?
  occurredAt  DateTime          @map("occurred_at") @db.Timestamptz(3)
  payments    LayawayPayment[]

  @@index([layawayId, occurredAt])
  @@map("layaway_actions")
}

model LayawayPayment {
  id             String             @id @default(uuid()) @db.Uuid
  actionId       String             @map("action_id") @db.Uuid
  action         LayawayAction      @relation(fields: [actionId], references: [id], onDelete: Restrict)
  position       Int
  kind           LayawayPaymentKind
  reversedId     String?            @unique @map("reversed_id") @db.Uuid
  reversed       LayawayPayment?    @relation("LayawayRefund", fields: [reversedId], references: [id], onDelete: Restrict)
  refund         LayawayPayment?    @relation("LayawayRefund")
  accountId      String             @map("account_id") @db.Uuid
  account        MoneyAccount       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountName    String             @map("account_name") @db.VarChar(120)
  currencyCode   String             @map("currency_code") @db.VarChar(5)
  currency       Currency           @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  exchangeRateId String?            @map("exchange_rate_id") @db.Uuid
  exchangeRate   ExchangeRate?      @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  unitsPerUsd    Decimal            @map("units_per_usd") @db.Decimal(30, 12)
  amountOriginal Decimal            @map("amount_original") @db.Decimal(38, 8)
  amountUsd      Decimal            @map("amount_usd") @db.Decimal(48, 2)
  reference      String?            @db.VarChar(120)
  movement       MoneyMovement?

  @@unique([actionId, position])
  @@index([accountId])
  @@map("layaway_payments")
}

enum SaleCorrectionKind {
  RETURN
  EXCHANGE
}

enum ReturnCondition {
  SELLABLE
  DEFECTIVE
}

enum CorrectionTenderKind {
  PAYMENT
  REFUND
}

model SaleCorrection {
  id                  String               @id @default(uuid()) @db.Uuid
  number              BigInt               @unique @default(autoincrement())
  operationKey        String               @unique @map("operation_key") @db.Uuid
  operationDigest     String               @map("operation_digest") @db.Char(64)
  saleId              String               @map("sale_id") @db.Uuid
  sale                Sale                 @relation("CorrectedSale", fields: [saleId], references: [id], onDelete: Restrict)
  replacement         Sale?                @relation("ReplacementSale")
  actorId             String               @map("actor_id") @db.Uuid
  actor               User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorName           String               @map("actor_name") @db.VarChar(120)
  kind                SaleCorrectionKind
  reason              String
  notes               String?
  returnedUsd         Decimal              @map("returned_usd") @db.Decimal(48, 2)
  restoredCogsUsd     Decimal              @map("restored_cogs_usd") @db.Decimal(48, 2)
  replacementTotalUsd Decimal              @map("replacement_total_usd") @db.Decimal(48, 2)
  differenceUsd       Decimal              @map("difference_usd") @db.Decimal(48, 2)
  createdAt           DateTime             @map("created_at") @db.Timestamptz(3)
  items               SaleCorrectionItem[]
  tenders             CorrectionTender[]

  @@index([saleId, createdAt])
  @@index([createdAt, id])
  @@map("sale_corrections")
}

model SaleCorrectionItem {
  id              String          @id @default(uuid()) @db.Uuid
  correctionId    String          @map("correction_id") @db.Uuid
  correction      SaleCorrection  @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  saleItemId      String          @map("sale_item_id") @db.Uuid
  saleItem        SaleItem        @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  position        Int
  condition       ReturnCondition
  quantity        Int
  creditUsd       Decimal         @map("credit_usd") @db.Decimal(48, 2)
  restoredCogsUsd Decimal         @map("restored_cogs_usd") @db.Decimal(48, 2)
  lots            InventoryLot[]
  movement        StockMovement?

  @@unique([correctionId, position])
  @@unique([correctionId, saleItemId, condition])
  @@index([saleItemId])
  @@map("sale_correction_items")
}

model CorrectionTender {
  id             String               @id @default(uuid()) @db.Uuid
  correctionId   String               @map("correction_id") @db.Uuid
  correction     SaleCorrection       @relation(fields: [correctionId], references: [id], onDelete: Restrict)
  position       Int
  kind           CorrectionTenderKind
  accountId      String               @map("account_id") @db.Uuid
  account        MoneyAccount         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountName    String               @map("account_name") @db.VarChar(120)
  currencyCode   String               @map("currency_code") @db.VarChar(5)
  currency       Currency             @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  exchangeRateId String?              @map("exchange_rate_id") @db.Uuid
  exchangeRate   ExchangeRate?        @relation(fields: [exchangeRateId], references: [id], onDelete: Restrict)
  unitsPerUsd    Decimal              @map("units_per_usd") @db.Decimal(30, 12)
  amountOriginal Decimal              @map("amount_original") @db.Decimal(38, 8)
  amountUsd      Decimal              @map("amount_usd") @db.Decimal(48, 2)
  reference      String?              @db.VarChar(120)
  movement       MoneyMovement?

  @@unique([correctionId, position])
  @@index([accountId])
  @@map("correction_tenders")
}
