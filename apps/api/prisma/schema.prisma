generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  CASH
  BANK
  MOBILE
  CRYPTO
  OTHER
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  label       String           @db.VarChar(100)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id    String           @id @default(uuid()) @db.Uuid
  code  String           @unique @db.VarChar(80)
  label String           @db.VarChar(140)
  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model User {
  id                 String         @id @default(uuid()) @db.Uuid
  email              String         @unique @db.VarChar(254)
  displayName        String         @map("display_name") @db.VarChar(120)
  passwordHash       String         @map("password_hash") @db.VarChar(255)
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  active             Boolean        @default(true)
  roleId             String         @map("role_id") @db.Uuid
  role               Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions           UserSession[]
  auditLogs          AuditLog[]
  exchangeRates      ExchangeRate[]
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([roleId])
  @@map("users")
}

model UserSession {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(60)
  entityId  String   @map("entity_id") @db.VarChar(80)
  before    Json?    @map("before_data")
  after     Json?    @map("after_data")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entity, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Brand {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @db.VarChar(120)
  nameKey   String         @unique @map("name_key") @db.VarChar(120)
  active    Boolean        @default(true)
  models    ProductModel[]
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brands")
}

model ProductModel {
  id          String           @id @default(uuid()) @db.Uuid
  brandId     String           @map("brand_id") @db.Uuid
  brand       Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  name        String           @db.VarChar(140)
  nameKey     String           @map("name_key") @db.VarChar(140)
  description String?
  active      Boolean          @default(true)
  variants    ProductVariant[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([brandId, nameKey])
  @@map("product_models")
}

model ProductVariant {
  id                String       @id @default(uuid()) @db.Uuid
  modelId           String       @map("model_id") @db.Uuid
  model             ProductModel @relation(fields: [modelId], references: [id], onDelete: Restrict)
  size              Int          @db.SmallInt
  color             String?      @db.VarChar(80)
  colorKey          String       @default("") @map("color_key") @db.VarChar(80)
  sku               String       @unique @db.VarChar(60)
  salePriceUsd      Decimal      @map("sale_price_usd") @db.Decimal(18, 2)
  lowStockThreshold Int?         @map("low_stock_threshold")
  active            Boolean      @default(true)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([modelId, size, colorKey])
  @@index([size])
  @@map("product_variants")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  document  String?  @db.VarChar(60)
  phone     String?  @db.VarChar(60)
  email     String?  @db.VarChar(254)
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([document])
  @@map("customers")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  document  String?  @db.VarChar(60)
  phone     String?  @db.VarChar(60)
  email     String?  @db.VarChar(254)
  address   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([name])
  @@index([document])
  @@map("suppliers")
}

model Currency {
  code       String         @id @db.VarChar(5)
  name       String         @db.VarChar(80)
  minorUnits Int            @map("minor_units") @db.SmallInt
  active     Boolean        @default(true)
  rates      ExchangeRate[]
  accounts   MoneyAccount[]

  @@map("currencies")
}

model ExchangeRate {
  id           String        @id @default(uuid()) @db.Uuid
  currencyCode String        @map("currency_code") @db.VarChar(5)
  currency     Currency      @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  unitsPerUsd  Decimal       @map("units_per_usd") @db.Decimal(30, 12)
  effectiveAt  DateTime      @map("effective_at") @db.Timestamptz(3)
  createdById  String        @map("created_by_id") @db.Uuid
  createdBy    User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(3)
  replacesId   String?       @unique @map("replaces_id") @db.Uuid
  replaces     ExchangeRate? @relation("RateRevisions", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement  ExchangeRate? @relation("RateRevisions")

  @@index([currencyCode, effectiveAt(sort: Desc), createdAt(sort: Desc)])
  @@index([createdById])
  @@map("exchange_rates")
}

model MoneyAccount {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(120)
  currencyCode String      @map("currency_code") @db.VarChar(5)
  currency     Currency    @relation(fields: [currencyCode], references: [code], onDelete: Restrict)
  kind         AccountKind
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([currencyCode, name])
  @@map("money_accounts")
}

model ShopSettings {
  id                Int      @id @default(1) @db.SmallInt
  name              String   @default("MAX Sport Manager") @db.VarChar(160)
  timezone          String   @default("America/Caracas") @db.VarChar(80)
  logoUrl           String?  @map("logo_url")
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("shop_settings")
}
